{
  "permissions": {
    "ask": [
      "Edit(/schema/**)",
      "Write(/schema/**)"
    ],
    "allow": [
      "Bash(supabase migration list:*)",
      "Bash(supabase db diff:*)",
      "Bash(supabase projects list:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" protect"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" commit",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
