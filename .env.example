# 저장소 루트 환경변수 템플릿 (커밋 대상, 값 없음)
# 실제 값은 루트 .env 에 넣는다(.gitignore가 .env, .env.* 를 막고 이 파일만 추적한다).
# 블록별 상세 설명: backend/.env.example, frontend/.env.example

# --- Supabase ---
SUPABASE_URL=                     # Supabase Dashboard > Settings > API (Project URL)
SUPABASE_SECRET_KEY=              # Supabase Dashboard > Settings > API Keys (secret, 백엔드와 배치 전용)
SUPABASE_ACCESS_TOKEN=            # Supabase Dashboard > Account > Access Tokens (CLI, 마이그레이션)
NEXT_PUBLIC_SUPABASE_URL=         # 위 Project URL과 같음 (프론트, frontend/.env.local)
NEXT_PUBLIC_SUPABASE_ANON_KEY=    # Supabase Dashboard > Settings > API Keys (publishable/anon, 프론트)

# --- 텍스트 블록 (뉴스, 재무) ---
GEMINI_API_KEY=                   # Google AI Studio https://aistudio.google.com (무료 티어)
DART_API_KEY=                     # OpenDART https://opendart.fss.or.kr (무료)
NEWSAPI_AI_KEY=                   # NewsAPI.ai https://newsapi.ai (무료 한도)
NAVER_CLIENT_ID=                  # 네이버 개발자센터 검색 API(뉴스). 데이터랩(검색량)은 API HUB 이관으로 보류
NAVER_CLIENT_SECRET=              # 위와 같음. 데이터랩은 API HUB 이관으로 보류

# --- 차트 블록 ---
KRX_ID=                           # KRX 정보데이터시스템 계정. 운영 값은 GitHub Actions 시크릿(로컬 실행에만 필요)
KRX_PW=                           # 위와 같음. GitHub Actions 시크릿
DATA_GO_KR_KEY=                   # 공공데이터포털 https://www.data.go.kr 개발계정(금융투자협회 통계 GetKofiaStatisticsInfoService)
