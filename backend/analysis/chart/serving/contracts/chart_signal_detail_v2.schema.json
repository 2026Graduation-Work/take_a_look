{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chart_signal_detail_v2",
  "title": "chart_signal_detail_v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "stock_code",
    "stock_name",
    "data_asof",
    "horizon",
    "profile",
    "release_id",
    "batch_id",
    "inference",
    "distribution",
    "prices",
    "sources",
    "pack_id"
  ],
  "properties": {
    "contract": {
      "const": "chart_signal_detail_v2"
    },
    "stock_code": {
      "type": "string",
      "pattern": "^[0-9A-Z]{6}$"
    },
    "stock_name": {
      "type": "string",
      "minLength": 1
    },
    "data_asof": {
      "type": "string",
      "format": "date"
    },
    "horizon": {
      "enum": [
        5,
        20
      ]
    },
    "profile": {
      "enum": [
        "stable",
        "aggressive"
      ]
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "scores",
        "score_event",
        "close",
        "sigma",
        "barriers",
        "contribution_space",
        "features"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "scores": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "down",
                "neutral",
                "up"
              ],
              "properties": {
                "down": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "neutral": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "up": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          ]
        },
        "score_event": {
          "const": "class_2_upper_barrier_first"
        },
        "close": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "sigma": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "barriers": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "up",
                "down"
              ],
              "properties": {
                "up": {
                  "type": "number"
                },
                "down": {
                  "type": "number"
                }
              }
            }
          ]
        },
        "contribution_space": {
          "const": "class_2_raw_margin"
        },
        "contribution_abs_sum": {
          "type": "number",
          "minimum": 0,
          "description": "Sum of absolute class-2 raw-margin contributions over every feature, excluding the expected-value column. Optional for archived v2 snapshots."
        },
        "features": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "label_ko",
              "meaning_ko",
              "value",
              "contribution"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "label_ko": {
                "type": "string"
              },
              "meaning_ko": {
                "type": "string"
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "contribution": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "prices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "source",
        "history"
      ],
      "properties": {
        "basis": {
          "const": "adjusted_close"
        },
        "source": {
          "type": "string"
        },
        "history": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "close",
              "volume"
            ],
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "close": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "volume": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_sha256",
        "features_sha256",
        "prices_sha256",
        "cases_sha256",
        "config_sha256"
      ],
      "properties": {
        "model_sha256": {
          "$ref": "#/$defs/hash"
        },
        "features_sha256": {
          "$ref": "#/$defs/hash"
        },
        "prices_sha256": {
          "$ref": "#/$defs/hash"
        },
        "cases_sha256": {
          "$ref": "#/$defs/hash"
        },
        "config_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "policy_id",
        "current",
        "tolerances",
        "sample_count",
        "stock_count",
        "period_start",
        "period_end",
        "observed_through",
        "by_fold",
        "histogram"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "no_cases",
            "unavailable"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy_id": {
          "const": "multi_stock_up_sigma_001_005_v1"
        },
        "current": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "up",
                "sigma"
              ],
              "properties": {
                "up": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "sigma": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "tolerances": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "up_absolute",
            "sigma_relative"
          ],
          "properties": {
            "up_absolute": {
              "const": 0.01
            },
            "sigma_relative": {
              "const": 0.05
            }
          }
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "stock_count": {
          "type": "integer",
          "minimum": 0
        },
        "period_start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "period_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "observed_through": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "by_fold": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "histogram": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bins",
            "central_68"
          ],
          "properties": {
            "bins": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "left",
                  "right",
                  "count"
                ],
                "properties": {
                  "left": {
                    "type": "number"
                  },
                  "right": {
                    "type": "number"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "central_68": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "low",
                    "high"
                  ],
                  "properties": {
                    "low": {
                      "type": "number"
                    },
                    "high": {
                      "type": "number"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
