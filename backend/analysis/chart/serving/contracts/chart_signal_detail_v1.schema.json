{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chart_signal_detail_v1",
  "title": "Chart signal detail v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "stock_code", "stock_name", "data_asof", "horizon", "profile", "release_id", "batch_id", "inference", "cases", "prices", "sources"],
  "properties": {
    "contract": {"const": "chart_signal_detail_v1"},
    "stock_code": {"type": "string", "pattern": "^[0-9A-Z]{6}$"},
    "stock_name": {"type": "string", "minLength": 1},
    "data_asof": {"type": "string", "format": "date"},
    "horizon": {"enum": [5, 20]},
    "profile": {"enum": ["stable", "aggressive"]},
    "release_id": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "inference": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason", "scores", "score_event", "close", "sigma", "barriers", "contribution_space", "features"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "reason": {"type": ["string", "null"]},
        "scores": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["down", "neutral", "up"], "properties": {"down": {"type": "number", "minimum": 0, "maximum": 1}, "neutral": {"type": "number", "minimum": 0, "maximum": 1}, "up": {"type": "number", "minimum": 0, "maximum": 1}}}]},
        "score_event": {"const": "class_2_upper_barrier_first"},
        "close": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "sigma": {"type": ["number", "null"], "minimum": 0},
        "barriers": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["up", "down"], "properties": {"up": {"type": "number"}, "down": {"type": "number"}}}]},
        "contribution_space": {"const": "class_2_raw_margin"},
        "features": {"type": "array", "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["name", "label_ko", "meaning_ko", "value", "contribution"], "properties": {"name": {"type": "string"}, "label_ko": {"type": "string"}, "meaning_ko": {"type": "string"}, "value": {"type": ["number", "null"]}, "contribution": {"type": "number"}}}}
      }
    },
    "cases": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason", "policy_id", "current", "tolerances", "sample_count", "up_count", "down_count", "both_count", "neither_count", "up_rate", "down_rate", "period_start", "period_end", "observed_through", "by_fold", "by_year"],
      "properties": {
        "status": {"enum": ["available", "no_cases", "unavailable"]},
        "reason": {"type": ["string", "null"]},
        "policy_id": {"const": "same_stock_up_down_001_sigma_rel010_v1"},
        "current": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["up", "down", "sigma"], "properties": {"up": {"type": "number"}, "down": {"type": "number"}, "sigma": {"type": "number"}}}]},
        "tolerances": {"type": "object", "additionalProperties": false, "required": ["up_absolute", "down_absolute", "sigma_relative"], "properties": {"up_absolute": {"const": 0.01}, "down_absolute": {"const": 0.01}, "sigma_relative": {"const": 0.1}}},
        "sample_count": {"type": "integer", "minimum": 0}, "up_count": {"type": "integer", "minimum": 0}, "down_count": {"type": "integer", "minimum": 0}, "both_count": {"type": "integer", "minimum": 0}, "neither_count": {"type": "integer", "minimum": 0},
        "up_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "down_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "period_start": {"type": ["string", "null"], "format": "date"}, "period_end": {"type": ["string", "null"], "format": "date"}, "observed_through": {"type": ["string", "null"], "format": "date"},
        "by_fold": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "by_year": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "prices": {"type": "object", "additionalProperties": false, "required": ["basis", "source", "history"], "properties": {"basis": {"const": "adjusted_close"}, "source": {"type": "string"}, "history": {"type": "array", "maxItems": 60, "items": {"type": "object", "additionalProperties": false, "required": ["date", "close", "volume"], "properties": {"date": {"type": "string", "format": "date"}, "close": {"type": "number", "exclusiveMinimum": 0}, "volume": {"type": "number", "minimum": 0}}}}}},
    "sources": {"type": "object", "additionalProperties": false, "required": ["model_sha256", "features_sha256", "prices_sha256", "cases_sha256", "config_sha256"], "properties": {"model_sha256": {"$ref": "#/$defs/hash"}, "features_sha256": {"$ref": "#/$defs/hash"}, "prices_sha256": {"$ref": "#/$defs/hash"}, "cases_sha256": {"$ref": "#/$defs/hash"}, "config_sha256": {"$ref": "#/$defs/hash"}}}
  },
  "$defs": {"hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}
}
