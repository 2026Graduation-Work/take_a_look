# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---------- Node / Next.js ----------
# 블록별 디렉터리 구조이므로 루트 기준이 아닌 임의 깊이에서 매칭되도록 한다.
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
frontend/playwright-report/
frontend/test-results/

# next.js
.next/
out/

# production build
build/

# turbo
.turbo/

# typescript
*.tsbuildinfo
next-env.d.ts

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# ---------- Python (모델링) ----------
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---------- 환경 변수 ----------
# .env 류는 모두 무시하되, 템플릿인 .env.example만 추적한다.
.env
.env.*
!.env.example

# ---------- OS / Editor ----------
.DS_Store
*.pem
.idea/
# .vscode/는 일단 무시한다. 팀이 공유 설정(권장 익스텐션·디버그 설정 등)을 도입하면
# 아래 .vscode/ 줄을 제거하거나, 추적할 파일만 별도로 화이트리스트(!.vscode/extensions.json 등) 처리한다.
.vscode/

# WSL이 윈도우 파일에 붙이는 메타데이터
*:Zone.Identifier

# ---------- AI 코딩 도구 ----------
# Claude Code — 개인 설정은 무시하고, 검토한 디자인 스킬(AGENTS.md 허용 목록)만 추적한다
.claude/*
!.claude/skills/

# ---------- 데이터 및 로컬 설정 (Data & Config) ----------
**/data/
*.csv
*.parquet
**/config.yaml
!backend/analysis/chart/serving/config.yaml
/chart_handoff_output/

# 기본 Baseline 실험의 모델/캐시/결과는 Git에 올려서 공유 (추적 허용)
!**/experiments/cache/*_predictions.parquet
!**/experiments/cache/models/*_model.txt
!**/experiments/results/exp_001_base_lgbm/
**/experiments/results/exp_001_base_lgbm/*.html

# ---------- 차트 실험 산출물 ----------
